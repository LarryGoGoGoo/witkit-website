{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteProperties": "preserve"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      ".vite-cache",
      "src/styles/tokens.css",
      "src/i18n/tw.ts",
      "**/*.vue.js",
      "**/*.vue.d.ts"
    ]
  },
  "overrides": [
    {
      "include": ["src/i18n/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ]
}
